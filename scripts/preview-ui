#!/bin/sh
# Renderer local, sem PlatformIO, USB ou instalação de dependências.
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$project_root/.venv/bin/python" ]; then
    printf '%s\n' 'Falta .venv/bin/python (Python 3.12); siga o setup local do projeto.' >&2
    exit 1
fi
exec "$project_root/.venv/bin/python" "$project_root/tools/ui_preview/render.py" "$@"
